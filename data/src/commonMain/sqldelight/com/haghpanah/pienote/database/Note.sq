CREATE TABLE IF NOT EXISTS notes (
  id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
  title TEXT NOT NULL,
  markdown TEXT NOT NULL,
  image TEXT,
  added_time TEXT NOT NULL,
  last_changed_time TEXT,
  category_id INTEGER,
  color TEXT,
  FOREIGN KEY (category_id) REFERENCES categories(id)
);

getNotes:
SELECT * FROM notes;

getNoteWithCategoryById:
SELECT * FROM notes
LEFT JOIN categories
WHERE notes.id = ? ;

getNotesByCategoryId:
SELECT * FROM notes
WHERE category_id = ?
ORDER BY id DESC;

isTableEmpty:
SELECT (
    SELECT COUNT(*) FROM notes
) = 0;

deleteNote:
DELETE FROM notes
WHERE notes.id =?;

