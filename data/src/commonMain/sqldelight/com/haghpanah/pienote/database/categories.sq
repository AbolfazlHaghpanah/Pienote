CREATE TABLE IF NOT EXISTS categories (
  id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
  name TEXT NOT NULL,
  priority INTEGER,
  image TEXT
);

getCategories:
SELECT * FROM categories;

getCategoryWithNoteCount:
SELECT categories.*,COUNT(notes.id)
FROM categories
LEFT JOIN notes ON category_id = categories.id
GROUP BY categories.id
ORDER BY categories.id DESC;

addCategory:
INSERT INTO
categories (name, priority, image)
VALUES ?;

getCategoryById:
SELECT * FROM categories
LEFT JOIN notes
ON notes.category_id = categories.id
WHERE categories.id = ?;

insertOrReplaceCategory:
INSERT OR REPLACE INTO
categories(id,name, priority, image)
VALUES :category;

